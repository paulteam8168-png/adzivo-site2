# Copy to .dev.vars for local testing. On Cloudflare, add these in
# Pages project > Settings > Variables and Secrets. NEVER commit real values.

# --- Build-time variable (Plain text) ---
SITE_URL=https://www.your-domain.com

# --- Runtime secrets for the contact form (Secret) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Optional spam protection (Cloudflare Turnstile) ---
TURNSTILE_SECRET=
